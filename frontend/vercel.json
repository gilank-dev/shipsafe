{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/audit",
      "destination": "http://213.163.197.214:23010/api/audit"
    },
    {
      "source": "/api/audit/:path*",
      "destination": "http://213.163.197.214:23010/api/audit/:path*"
    },
    {
      "source": "/api/health",
      "destination": "http://213.163.197.214:23010/api/health"
    },
    {
      "source": "/api/queue",
      "destination": "http://213.163.197.214:23010/api/queue"
    },
    {
      "source": "/api/ai/:path*",
      "destination": "http://213.163.197.214:23010/api/ai/:path*"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "http://213.163.197.214:23010/api/auth/:path*"
    },
    {
      "source": "/api/import-repo",
      "destination": "http://213.163.197.214:23010/api/import-repo"
    },
    {
      "source": "/api/cli/:path*",
      "destination": "http://213.163.197.214:23010/api/cli/:path*"
    },
    {
      "source": "/api/admin/:path*",
      "destination": "http://213.163.197.214:23010/api/admin/:path*"
    },
    {
      "source": "/api/vouchers/:path*",
      "destination": "http://213.163.197.214:23010/api/vouchers/:path*"
    },
    {
      "source": "/api/user/:path*",
      "destination": "http://213.163.197.214:23010/api/user/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
