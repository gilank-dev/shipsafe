# API Mode: 'mock' (in-browser demo engine) or 'http' (talks to ShipSafe API at VITE_API_BASE_URL)
VITE_API_MODE=http
VITE_API_BASE_URL=/api

# Optional mock latency: 'normal' or 'none' (tests)
VITE_MOCK_LATENCY=normal

# Clerk Authentication (Client Publishable Key)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_clerk_publishable_key

# Supabase Auth & Database (Public Configuration)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Cloudflare Turnstile CAPTCHA (Site Key)
VITE_TURNSTILE_ENABLED=true
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000BB
