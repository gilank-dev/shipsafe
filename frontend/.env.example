# mock: in-browser demo engine. http: talks to the ShipSafe API at VITE_API_BASE_URL.
VITE_API_MODE=mock
VITE_API_BASE_URL=/api

# normal: simulated stage delays. none: instant (tests).
VITE_MOCK_LATENCY=normal

# Supabase Auth & Storage
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Cloudflare Turnstile CAPTCHA (Default: Cloudflare Always-Passes Test Sitekey)
VITE_TURNSTILE_ENABLED=true
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

