# ShipSafe Backend VPS Configuration
PORT=23010
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,https://ship-safe.lankdev.my.id,https://shipsafe-lankdev.vercel.app

# Upload Security
MAX_ZIP_SIZE_MB=10

# Clerk Authentication (Server Secret Key)
CLERK_SECRET_KEY=sk_test_placeholder_clerk_secret_key
# Set to 'true' only for isolated automated test runs
AUTH_TEST_BYPASS=false

# CLI Access Token Signing Secret (HMAC-SHA256, 32+ characters)
CLI_TOKEN_SECRET=your-random-32-character-secret-key-for-cli-tokens

# Supabase Server SDK (Optional)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# AI Gateway
AI_BASE_URL=https://your-ai-gateway-url/v1
AI_API_KEY=your-ai-api-key-here
AI_MODEL=hermes-agent

# Cloudflare Turnstile CAPTCHA (Server Verification)
TURNSTILE_ENABLED=true
# Set either TURNSTILE_SECRET or CLOUDFLARE_TURNSTILE_SECRET_KEY
TURNSTILE_SECRET=your-turnstile-secret-key-here
CLOUDFLARE_TURNSTILE_SECRET_KEY=your-turnstile-secret-key-here
TURNSTILE_EXPECTED_ACTION=audit
TURNSTILE_HOSTNAMES=localhost,ship-safe.lankdev.my.id,shipsafe-lankdev.vercel.app
