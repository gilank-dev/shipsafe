# ==============================================================================
# ShipSafe — Unified Environment Variables Template (.env.example)
# ==============================================================================
# Salin berkas ini ke masing-masing folder atau gunakan sebagai referensi.
# PERINGATAN: Jangan pernah meng-commit berkas .env dengan rahasia nyata ke git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT (frontend/.env)
# ------------------------------------------------------------------------------
# Mode API: 'mock' (demo in-browser tanpa backend) atau 'http' (koneksi ke backend API)
VITE_API_MODE=http
VITE_API_BASE_URL=/api

# Simulasi latensi mock: 'normal' (delay bertahap) atau 'none' (instan untuk unit tests)
VITE_MOCK_LATENCY=normal

# Clerk Authentication (Client Publishable Key)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_clerk_publishable_key

# Supabase Auth & Client (Public Anonymous Key)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Cloudflare Turnstile CAPTCHA (Frontend Site Key)
VITE_TURNSTILE_ENABLED=true
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000BB

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT (backend/.env)
# ------------------------------------------------------------------------------
# Server Network & Runtime
PORT=23010
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,https://ship-safe.lankdev.my.id,https://shipsafe-lankdev.vercel.app

# Keamanan & Batas Payload Upload
MAX_ZIP_SIZE_MB=10

# Clerk Authentication (Server Secret Key)
CLERK_SECRET_KEY=sk_test_placeholder_clerk_secret_key
# Bypass autentikasi khusus untuk test suite lokal
AUTH_TEST_BYPASS=false

# Cloudflare Turnstile CAPTCHA (Backend Verification)
TURNSTILE_ENABLED=true
# Set TURNSTILE_SECRET atau CLOUDFLARE_TURNSTILE_SECRET_KEY
TURNSTILE_SECRET=your-turnstile-secret-key-here
CLOUDFLARE_TURNSTILE_SECRET_KEY=your-turnstile-secret-key-here
TURNSTILE_EXPECTED_ACTION=audit
TURNSTILE_HOSTNAMES=localhost,ship-safe.lankdev.my.id,shipsafe-lankdev.vercel.app

# Supabase Server-Side SDK & Database (Opsional)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# ------------------------------------------------------------------------------
# 3. AI API GATEWAY & LLM CONFIGURATION
# ------------------------------------------------------------------------------
AI_BASE_URL=https://your-ai-gateway-url/v1
AI_API_KEY=your-ai-api-key-here
AI_MODEL=hermes-agent
