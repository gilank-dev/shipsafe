# ==============================================================================
# ShipSafe — Unified Environment Variables Template (.env.example)
# ==============================================================================
# Salin berkas ini ke masing-masing folder atau gunakan sebagai referensi.
# PERINGATAN: Jangan pernah meng-commit berkas .env dengan rahasia nyata ke git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT (frontend/.env)
# ------------------------------------------------------------------------------
# Mode API: 'mock' (demo in-browser tanpa backend) atau 'http' (koneksi ke backend VPS)
VITE_API_MODE=http
VITE_API_BASE_URL=http://localhost:23010/api

# Simulasi latensi mock: 'normal' (delay bertahap) atau 'none' (instan untuk unit tests)
VITE_MOCK_LATENCY=normal

# Supabase Auth & Client (Public Anonymous Key)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# 2. BACKEND VPS ENVIRONMENT (backend/.env)
# ------------------------------------------------------------------------------
# Server Network & Runtime
PORT=23010
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,https://shipsafe.vercel.app

# Keamanan & Batas Payload Upload
MAX_ZIP_SIZE_MB=10

# Supabase Server-Side SDK & JWT Authentication
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# ------------------------------------------------------------------------------
# 3. AI API GATEWAY & LLM CONFIGURATION
# ------------------------------------------------------------------------------
# Konfigurasi gateway 9Router / OpenAI-compatible endpoint untuk analisis keamanan
AI_BASE_URL=https://vps-9router.tail98895b.ts.net/v1
AI_API_KEY=sk-013ff93e8c768285-81m105-781f0714
AI_MODEL=hermes-agent
